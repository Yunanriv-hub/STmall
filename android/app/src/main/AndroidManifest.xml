<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE：Android 12+ 用 SCAN/CONNECT；以下用 BLUETOOTH_ADMIN -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- API<31 扫 BLE 需要定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 扫饮水机二维码 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- 抓取期间的前台服务：App 要退到后台，必须靠它把进程顶到前台优先级，
         否则会被 ColorOS 之类的系统冻结，Shizuku 的 binder 回调直接断掉。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 检查更新需要联网。注意：**开锁全程不联网**，这里只为更新功能而申请。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- NFC 是增强入口，不应阻止无 NFC 手机安装其他功能 -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- 相机只是扫码用，没有也能装（可手输设备号） -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <queries>
        <package android:name="com.tmall.campus.and" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>

    <application
        android:name=".FktmApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FkTM"
        tools:targetApi="34"
        tools:replace="android:theme">

        <activity
            android:name=".nfc.NfcTagActivity"
            android:exported="true"
            android:label="慧生活 NFC"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="https"
                    android:host="i.ilife798.com"
                    android:pathPrefix="/nfc.html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="https"
                    android:host="i.hnkzy.com"
                    android:pathPrefix="/nfc.html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="https"
                    android:host="act.hnkzy.com"
                    android:pathPrefix="/nfc.html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="https"
                    android:host="act2.hnkzy.com"
                    android:pathPrefix="/nfc.html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/com.cloudora.android" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <activity
            android:name=".scan.DeviceScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.FkTM">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 桌面快捷方式：一键开锁 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="fktm" android:host="unlock" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 下拉快捷磁贴：一点开锁 -->
        <service
            android:name=".QuickUnlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_unlock"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          抓取凭证期间的前台服务。
          抓取要求用户切到天猫校园开一次锁 → fkTM 全程在后台；
          不起前台服务的话会被 ColorOS 冻结，抓取必然失败（已真机复现）。
        -->
        <service
            android:name=".credential.GrabForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Shizuku：用来以 shell 身份读 logcat，抓取天猫校园下发的 activationKey。
          Android 4.1+ 普通 App 只能看自己进程的日志，READ_LOGS 又是系统级权限，
          所以「一键抓凭证」必须借 Shizuku（其本质是免 root 的 adb 通道）。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          更新用的 FileProvider：把 cache/updates/ 里下好的 APK 以 content:// 交给系统安装器。
          路径映射见 res/xml/file_paths.xml。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- LSPatch 模块（跑在天猫校园进程里）把 cookie 推过来。
             用 Provider 而不是广播：fkTM 被 ColorOS 冻结时收不到广播，
             但 Provider 调用会主动拉起本进程。 -->
        <provider
            android:name=".water.CookieImportProvider"
            android:authorities="com.rea.campuslite.cookies"
            android:exported="true" />

        <!-- 同样用途的广播接收器（fkTM 在前台时的备用通道） -->
        <receiver
            android:name=".water.CookieImportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rea.campuslite.ACTION_COOKIES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
